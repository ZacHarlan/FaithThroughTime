{"H8500":{"lemma":"תֻּכִּי","translit":"tukkîy","pron":"took-kee'","def":"probably of foreign derivation; some imported creature, probably a peacock","kjv":"peacock","deriv":"or תּוּכִּי"},"H8501":{"lemma":"תָּכָךְ","translit":"tâkâk","pron":"taw-kawk'","def":"to dissever, i.e. crush","kjv":"deceitful","deriv":"from an unused root meaning"},"H8502":{"lemma":"תִּכְלָה","translit":"tiklâh","pron":"tik-law'","def":"completeness","kjv":"perfection","deriv":"from H3615 (כָּלָה)"},"H8503":{"lemma":"תַּכְלִית","translit":"taklîyth","pron":"tak-leeth'","def":"completion; by implication, an extremity","kjv":"end, perfect(-ion)","deriv":"from H3615 (כָּלָה)"},"H8504":{"lemma":"תְּכֵלֶת","translit":"tᵉkêleth","pron":"tek-ay'-leth","def":"the cerulean mussel, i.e. the color (violet) obtained therefrom or stuff dyed therewith","kjv":"blue","deriv":"probably for H7827 (שְׁחֶלֶת)"},"H8505":{"lemma":"תָּכַן","translit":"tâkan","pron":"taw-kan'","def":"to balance, i.e. measure out (by weight or dimension); figuratively, arrange, equalize, through the idea of levelling (ment. estimate, test)","kjv":"bear up, direct, be (un-)equal, mete, ponder, tell, weigh","deriv":"a primitive root"},"H8506":{"lemma":"תֹּכֶן","translit":"tôken","pron":"to'-ken","def":"a fixed quantity","kjv":"measure, tale","deriv":"from H8505 (תָּכַן)"},"H8507":{"lemma":"תֹּכֶן","translit":"Tôken","pron":"to'-ken","def":"Token, a place in Palestine","kjv":"Tochen","deriv":"the same as H8506 (תֹּכֶן)"},"H8508":{"lemma":"תׇּכְנִית","translit":"toknîyth","pron":"tok-neeth'","def":"admeasurement, i.e. consummation","kjv":"pattern, sum","deriv":"from H8506 (תֹּכֶן)"},"H8509":{"lemma":"תַּכְרִיךְ","translit":"takrîyk","pron":"tak-reek'","def":"a wrapper or robe","kjv":"garment","deriv":"apparently from an unused root meaning to encompass"},"H8510":{"lemma":"תֵּל","translit":"têl","pron":"tale","def":"a mound","kjv":"heap, [idiom] strength","deriv":"by contraction from H8524 (תָּלַל)"},"H8511":{"lemma":"תָּלָא","translit":"tâlâʼ","pron":"taw-law'","def":"to suspend; figuratively (through hesitation) to be uncertain; by implication (of mental dependence) to habituate","kjv":"be bent, hang (in doubt)","deriv":"a primitive root"},"H8512":{"lemma":"תֵּל אָבִיב","translit":"Têl ʼÂbîyb","pron":"tale aw-beeb'","def":"Tel-Abib, a place in Chaldaea","kjv":"Tel-abib","deriv":"from H8510 (תֵּל) and H24 (אָבִיב); mound of green growth"},"H8513":{"lemma":"תְּלָאָה","translit":"tᵉlâʼâh","pron":"tel-aw-aw'","def":"distress","kjv":"travail, travel, trouble","deriv":"from H3811 (לָאָה)"},"H8514":{"lemma":"תַּלְאוּבָה","translit":"talʼûwbâh","pron":"tal-oo-baw'","def":"desiccation","kjv":"great drought","deriv":"from H3851 (לַהַב)"},"H8515":{"lemma":"תְּלַאשַּׂר","translit":"Tᵉlaʼssar","pron":"tel-as-sar'","def":"Telassar, a region of Assyria","kjv":"Telassar","deriv":"or תְּלַשַּׂר; of foreign derivation"},"H8516":{"lemma":"תַּלְבֹּשֶׁת","translit":"talbôsheth","pron":"tal-bo'-sheth","def":"a garment","kjv":"clothing","deriv":"from H3847 (לָבַשׁ)"},"H8517":{"lemma":"תְּלַג","translit":"tᵉlag","pron":"tel-ag'","def":"snow","kjv":"snow","deriv":"(Aramaic) corresponding to H7950 (שֶׁלֶג)"},"H8518":{"lemma":"תָּלָה","translit":"tâlâh","pron":"taw-law'","def":"to suspend (especially to gibbet)","kjv":"hang (up)","deriv":"a primitive root"},"H8519":{"lemma":"תְּלוּנָה","translit":"tᵉlûwnâh","pron":"tel-oo-naw'","def":"a grumbling","kjv":"murmuring","deriv":"or תּלֻנָּה; from H3885 (לוּן) in the sense of obstinacy"},"H8520":{"lemma":"תֶּלַח","translit":"Telach","pron":"teh'-lakh","def":"Telach, an Israelite","kjv":"Telah","deriv":"probably from an unused root meaning to dissever; breach"},"H8521":{"lemma":"תֵּל חַרְשָׁא","translit":"Têl Charshâʼ","pron":"tale khar-shaw'","def":"Tel-Charsha, a place in Babylonia","kjv":"Tel-haresha, Tel-harsa","deriv":"from H8510 (תֵּל) and the feminine of H2798 (חֲרָשִׁים); mound of workmanship"},"H8522":{"lemma":"תְּלִי","translit":"tᵉlîy","pron":"tel-ee'","def":"a quiver (as slung)","kjv":"quiver","deriv":"probably from H8518 (תָּלָה)"},"H8523":{"lemma":"תְּלִיתַי","translit":"tᵉlîythay","pron":"tel-ee-thah'-ee","def":"third","kjv":"third","deriv":"(Aramaic) or תַּלְתִּי; (Aramaic), ordinal from H8532 (תְּלָת)"},"H8524":{"lemma":"תָּלַל","translit":"tâlal","pron":"taw-lal'","def":"to pile up, i.e. elevate","kjv":"eminent. Compare H2048 (הָתַל)","deriv":"a primitive root"},"H8525":{"lemma":"תֶּלֶם","translit":"telem","pron":"teh'-lem","def":"a bank or terrace","kjv":"furrow, ridge","deriv":"from an unused root meaning to accumulate"},"H8526":{"lemma":"תַּלְמַי","translit":"Talmay","pron":"tal-mah'-ee","def":"Talmai, the name of a Canaanite and a Syrian","kjv":"Talmai","deriv":"from H8525 (תֶּלֶם); ridged"},"H8527":{"lemma":"תַּלְמִיד","translit":"talmîyd","pron":"tal-meed'","def":"a pupil","kjv":"scholar","deriv":"from H3925 (לָמַד)"},"H8528":{"lemma":"תֵּל מֶלַח","translit":"Têl Melach","pron":"tale meh'-lakh","def":"Tel-Melach, a place in Babylonia","kjv":"Tel-melah","deriv":"from H8510 (תֵּל) and H4417 (מֶלַח); mound of salt"},"H8529":{"lemma":"תָּלַע","translit":"tâlaʻ","pron":"taw-law'","def":"to crimson, i.e. dye that color","kjv":"[idiom] scarlet","deriv":"a denominative from H8438 (תּוֹלָע)"},"H8530":{"lemma":"תַּלְפִּיָּה","translit":"talpîyâh","pron":"tal-pee-yaw'","def":"something tall, i.e. (plural collective) slenderness","kjv":"armoury","deriv":"feminine from an unused root meaning to tower"},"H8531":{"lemma":"תְּלַת","translit":"tᵉlath","pron":"tel-ath'","def":"a tertiary rank","kjv":"third","deriv":"(Aramaic) from H8532 (תְּלָת)"},"H8532":{"lemma":"תְּלָת","translit":"tᵉlâth","pron":"tel-awth'","def":"three or third","kjv":"third, three","deriv":"(Aramaic) masculine תְּלָתָה; (Aramaic), or תְּלָתָא; (Aramaic), corresponding to H7969 (שָׁלוֹשׁ)"},"H8533":{"lemma":"תְּלָתִין","translit":"tᵉlâthîyn","pron":"tel-aw-theen'","def":"ten times three","kjv":"thirty","deriv":"(Aramaic) multiple of H8532 (תְּלָת)"},"H8534":{"lemma":"תַּלְתַּל","translit":"taltal","pron":"tal-tal'","def":"a trailing bough (as pendulous)","kjv":"bushy","deriv":"by reduplication, from H8524 (תָּלַל) through the idea of vibration"},"H8535":{"lemma":"תָּם","translit":"tâm","pron":"tawm","def":"complete; usually (morally) pious; specifically, gentle, dear","kjv":"coupled together, perfect, plain, undefiled, upright","deriv":"from H8552 (תָּמַם)"},"H8536":{"lemma":"תָּם","translit":"tâm","pron":"tawm","def":"there","kjv":"[idiom] thence, there, [idiom] where","deriv":"(Aramaic) corresponding to H8033 (שָׁם)"},"H8537":{"lemma":"תֹּם","translit":"tôm","pron":"tome","def":"completeness; figuratively, prosperity; usually (morally) innocence","kjv":"full, integrity, perfect(-ion), simplicity, upright(-ly, -ness), at a venture. See H8550 (תֻּמִּים)","deriv":"from H8552 (תָּמַם)"},"H8538":{"lemma":"תֻּמָּה","translit":"tummâh","pron":"toom-maw'","def":"innocence","kjv":"integrity","deriv":"feminine of H8537 (תֹּם)"},"H8539":{"lemma":"תָּמַהּ","translit":"tâmahh","pron":"taw-mah'","def":"to be in consternation","kjv":"be amazed, be astonished, marvel(-lously), wonder","deriv":"a primitive root"},"H8540":{"lemma":"תְּמַהּ","translit":"tᵉmahh","pron":"tem-ah'","def":"a miracle","kjv":"wonder","deriv":"(Aramaic) from a root corresponding to H8539 (תָּמַהּ)"},"H8541":{"lemma":"תִּמָּהוֹן","translit":"timmâhôwn","pron":"tim-maw-hone'","def":"consternation","kjv":"astonishment","deriv":"from H8539 (תָּמַהּ)"},"H8542":{"lemma":"תַּמּוּז","translit":"Tammûwz","pron":"tam-mooz'","def":"Tammuz, a Phoenician deity","kjv":"Tammuz","deriv":"of uncertain derivation"},"H8543":{"lemma":"תְּמוֹל","translit":"tᵉmôwl","pron":"tem-ole'","def":"properly, ago, i.e. a (short or long) time since; especially yesterday, or  day before yesterday","kjv":"[phrase] before (-time), [phrase] these (three) days, [phrase] heretofore, [phrase] time past, yesterday","deriv":"or תְּמֹל; probably for H865 (אֶתְמוֹל); sometimes with  H8032 (שִׁלְשׁוֹם)"},"H8544":{"lemma":"תְּמוּנָה","translit":"tᵉmûwnâh","pron":"tem-oo-naw'","def":"something portioned (i.e. fashioned) out, as ashape, i.e. (indefinitely) phantom, or (specifically) embodiment, or (figuratively) manifestation (of favor)","kjv":"image, likeness, similitude","deriv":"or תְּמֻנָה; from H4327 (מִין)"},"H8545":{"lemma":"תְּמוּרָה","translit":"tᵉmûwrâh","pron":"tem-oo-raw'","def":"barter, compensation","kjv":"(ex-) change(-ing), recompense, restitution","deriv":"from H4171 (מוּר)"},"H8546":{"lemma":"תְּמוּתָה","translit":"tᵉmûwthâh","pron":"tem-oo-thaw'","def":"execution (as a doom)","kjv":"death, die","deriv":"from H4191 (מוּת)"},"H8547":{"lemma":"תֶּמַח","translit":"Temach","pron":"teh'-makh","def":"Temach, one of the Nethinim","kjv":"Tamah, Thamah","deriv":"of uncertain derivation"},"H8548":{"lemma":"תָּמִיד","translit":"tâmîyd","pron":"taw-meed'","def":"properly, continuance (as indefinite extension); but used only (attributively as adjective) constant (or adverbially, constantly); ellipt. the regular (daily) sacrifice","kjv":"alway(-s), continual (employment, -ly), daily, (n-)ever(-more), perpetual","deriv":"from an unused root meaning to stretch"},"H8549":{"lemma":"תָּמִים","translit":"tâmîym","pron":"taw-meem'","def":"entire (literally, figuratively or morally); also (as noun) integrity, truth","kjv":"without blemish, complete, full, perfect, sincerely (-ity), sound, without spot, undefiled, upright(-ly), whole","deriv":"from H8552 (תָּמַם)"},"H8550":{"lemma":"תֻּמִּים","translit":"Tummîym","pron":"toom-meem'","def":"perfections, i.e. (techn.) one of the epithets of the objects in the high-priest's breastplate as an emblem of complete Truth","kjv":"Thummim","deriv":"plural of H8537 (תֹּם)"},"H8551":{"lemma":"תָּמַךְ","translit":"tâmak","pron":"taw-mak'","def":"to sustain; by implication, to obtain, keep fast; figuratively, to help, follow close","kjv":"(take, up-) hold (up), maintain, retain, stay (up)","deriv":"a primitive root"},"H8552":{"lemma":"תָּמַם","translit":"tâmam","pron":"taw-mam'","def":"to complete, in a good or a bad sense, literal, or figurative, transitive or intransitive","kjv":"accomplish, cease, be clean (pass-) ed, consume, have done, (come to an, have an, make an) end, fail, come to the full, be all gone, [idiom] be all here, be (make) perfect, be spent, sum, be (shew self) upright, be wasted, whole","deriv":"a primitive root"},"H8553":{"lemma":"תִּמְנָה","translit":"Timnâh","pron":"tim-naw'","def":"Timnah, the name of two places in Palestine","kjv":"Timnah, Timnath, Thimnathah","deriv":"from H4487 (מָנָה); a portion assigned"},"H8554":{"lemma":"תִּמְנִי","translit":"Timnîy","pron":"tim-nee'","def":"a Timnite or inhabitant of Timnah","kjv":"Timnite","deriv":"patrial from H8553 (תִּמְנָה)"},"H8555":{"lemma":"תִּמְנָע","translit":"Timnâʻ","pron":"tim-naw'","def":"Timna, the name of two Edomites","kjv":"Timna, Timnah","deriv":"from H4513 (מָנַע); restraint"},"H8556":{"lemma":"תִּמְנַת חֶרֶס","translit":"Timnath Chereç","pron":"tim-nath kheh'-res","def":"Timnath-Cheres, a place in Palestine","kjv":"Timnath-heres, Timnath-serah","deriv":"or תִּמְנַת סֶרַח; from H8553 (תִּמְנָה) and H2775 (חֶרֶס); portion of (the) sun"},"H8557":{"lemma":"תֶּמֶס","translit":"temeç","pron":"teh'-mes","def":"liquefaction, i.e. disappearance","kjv":"melt","deriv":"from H4529 (מָסָה)"},"H8558":{"lemma":"תָּמָר","translit":"tâmâr","pron":"taw-mawr'","def":"a palm tree","kjv":"palm (tree)","deriv":"from an unused root meaning to be erect"},"H8559":{"lemma":"תָּמָר","translit":"Tâmâr","pron":"taw-mawr'","def":"Tamar, the name of three women and a place","kjv":"Tamar","deriv":"the same as H8558 (תָּמָר)"},"H8560":{"lemma":"תֹּמֶר","translit":"tômer","pron":"to'-mer","def":"a palm trunk","kjv":"palm tree","deriv":"from the same root as H8558 (תָּמָר)"},"H8561":{"lemma":"תִּמֹּר","translit":"timmôr","pron":"tim-more'","def":"(architectural) a palm-like pilaster (i.e. umbellate)","kjv":"palm tree","deriv":"(plural or (feminine) תִּמֹּרָה; (singular and plural), from the same root as H8558 (תָּמָר)"},"H8562":{"lemma":"תַּמְרוּק","translit":"tamrûwq","pron":"tam-rook'","def":"properly, a scouring, i.e. soap or perfumery forthe bath; figuratively, a detergent","kjv":"[idiom] cleanse, (thing for) purification(-fying)","deriv":"or תַּמְרֻק; or תַּמְרִיק; from H4838 (מָרַק)"},"H8563":{"lemma":"תַּמְרוּר","translit":"tamrûwr","pron":"tam-roor'","def":"bitterness (plural as collective)","kjv":"[idiom] most bitter(-ly)","deriv":"from H4843 (מָרַר)"},"H8564":{"lemma":"תַּמְרוּר","translit":"tamrûwr","pron":"tam-roor'","def":"an erection, i.e. pillar (probably for a guide-board)","kjv":"high heap","deriv":"from the same root as H8558 (תָּמָר)"},"H8565":{"lemma":"תַּן","translit":"tan","pron":"tan","def":"a monster (as preternaturally formed), i.e. a sea-serpent (or other huge marine animal); also a jackal (or other hideous land animal)","kjv":"dragon, whale. Compare H8577 (תַּנִּין)","deriv":"from an unused root probably meaning to elongate"},"H8566":{"lemma":"תָּנָה","translit":"tânâh","pron":"taw-naw'","def":"to present (a mercenary inducement), i.e. bargain with (a harlot)","kjv":"hire","deriv":"a primitive root"},"H8567":{"lemma":"תָּנָה","translit":"tânâh","pron":"taw-naw'","def":"to ascribe (praise), i.e. celebrate, commemorate","kjv":"lament, rehearse","deriv":"a primitive root (identical with through the idea of attributing honor)"},"H8568":{"lemma":"תַּנָּה","translit":"tannâh","pron":"tan-naw'","def":"a female jackal","kjv":"dragon","deriv":"probably feminine of H8565 (תַּן)"},"H8569":{"lemma":"תְּנוּאָה","translit":"tᵉnûwʼâh","pron":"ten-oo-aw'","def":"alienation; by implication, enmity","kjv":"breach of promise, occasion","deriv":"from H5106 (נוּא)"},"H8570":{"lemma":"תְּנוּבָה","translit":"tᵉnûwbâh","pron":"ten-oo-baw'","def":"produce","kjv":"fruit, increase","deriv":"from H5107 (נוּב)"},"H8571":{"lemma":"תְּנוּךְ","translit":"tᵉnûwk","pron":"ten-ook'","def":"a pinnacle, i.e. extremity",